# Anything pulled off a disc image. Never commit these: they are the game's own files,
# not the converted models under models/. You generate this directory yourself by
# following docs/START_HERE.md.
/extracted/

# Ghidra project: it contains the game's executable and code.
/ghidra/

# Raw decompiler output: a mechanical translation of the game's code. Regenerate it with
# tools/GhidraScripts/ instead. See NOTICE.md.
/notes/decomp*/

# Bulk tool output under notes/: session logs and raw Ghidra dumps. Regenerable, large,
# and nothing reads them - what they taught us is written up in docs/.
/notes/*.log
/notes/funcstats_raw.txt
/notes/psx_named_functions.txt

# Drafts of the write-up. Personal writing rather than research; kept on disk, not
# published here. Delete these two lines to track them.
/notes/post_jade_cocoon_2026.md
/notes/post_jade_cocoon_2026_published.md

# Machine-specific paths.
/notes/LOCAL_PATHS.md

# Superseded export generations. Regenerable, and large.
/models/archive/

# Local tooling
.claude/
__pycache__/
*.pyc
.DS_Store
Thumbs.db
